# The OrgPay API behind Caddy (automatic HTTPS). Put this in /etc/caddy/Caddyfile, or import it, and
# set ORGPAY_DOMAIN (e.g. useorgpay.xyz) in Caddy's environment, or replace {$ORGPAY_DOMAIN} below.
# The dashboard is on Vercel at the same registrable domain (WEB_ORIGIN in .env), so the session
# cookie is sent. The API trusts exactly ONE proxy hop (this one): keep Cloudflare's proxy off.
api.{$ORGPAY_DOMAIN} {
	encode gzip zstd
	reverse_proxy 127.0.0.1:4400
}
